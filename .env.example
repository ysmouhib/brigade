# Copy to .env and fill in. Comments go on their own lines: some .env loaders
# keep anything written after a value on the same line.

# ---- modes ----
# Offline demo (no API key, no Lean install): FAKE_LLM=1 LEAN_MODE=fake
FAKE_LLM=0
# fake | file | repl  (file and repl need scripts/setup_lean.sh first)
LEAN_MODE=file

# ---- which API runs the agents ----
# anthropic = Claude (paid API) | openai = any OpenAI-compatible endpoint (free tiers too)
LLM_PROVIDER=anthropic
# For LLM_PROVIDER=openai, e.g. Google's free Gemini tier (key from aistudio.google.com);
# then set CHEF_MODEL and WORKER_MODEL below to that provider's model names.
#OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#OPENAI_API_KEY=

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
# chef / strategist / critic
CHEF_MODEL=claude-opus-4-8
# brainstormers / formalizer / prover / skeptic / decomposer
WORKER_MODEL=claude-sonnet-4-6

# ---- Lean (after scripts/setup_lean.sh) ----
LEAN_PROJECT_DIR=./lean/BrigadeLean
# only for LEAN_MODE=repl
LEAN_REPL_BIN=./lean/repl/.lake/build/bin/repl
LEAN_TIMEOUT_S=180

# ---- proving power (see README "Proving power") ----
# try omega/ring/simp/... in one Lean call before any prover tokens
TACTIC_CASCADE=1
# parallel proof candidates on the first attempt (try 4 for real runs)
PROVE_SAMPLES=1
# off | loogle | leansearch  (Mathlib premise retrieval, advisory only)
RETRIEVAL=off
# optional dedicated prover model (OpenAI-compatible endpoint)
#PROVER_BASE_URL=http://localhost:8000/v1
#PROVER_MODEL=Goedel-LM/Goedel-Prover-V2-8B
#PROVER_API_KEY=

# ---- persistence ----
# e.g. BRIGADE_DB=jobs.db to keep finished jobs across restarts
BRIGADE_DB=

# ---- budgets (per job; the app can lower/raise within clamps) ----
MAX_ROUNDS=2
N_BRAINSTORMERS=3
REPAIR_CYCLES=4
MAX_DEPTH=2
MAX_LEAN_CALLS=120
MAX_LLM_CALLS=200

# ---- server ----
PORT=8811
# set to require "Authorization: Bearer <token>"
AUTH_TOKEN=
